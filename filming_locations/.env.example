GMS_KEY=
GMS_MODEL=gpt-5.4-nano
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/
WIKI_CONTACT=

# 절약 기본값. 문맥/이력은 문자 수, 출력은 토큰 수입니다.
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=3
MAX_CONTEXT_CHARS=2600
MAX_HISTORY_CHARS=1000
MAX_QUESTION_CHARS=600
MAX_OUTPUT_TOKENS=600
DAILY_LLM_CALL_LIMIT=30
CACHE_TTL_DAYS=7

# 캡처 분석: 실제 GMS 계정에서 이미지 입력을 지원하는 모델명
# 비우면 GMS_MODEL을 사용합니다.
GMS_VISION_MODEL=
SCENE_OUTPUT_TOKENS=1200
SCENE_CONTEXT_CHARS=6000
